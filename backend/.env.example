# Antarctic Station Backend Configuration (Node.js/Express)
PORT=3001
NODE_ENV=production

# Comma-separated list of allowed origins or '*' (leave default for development)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Rate limiting
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX_CALLS=120
