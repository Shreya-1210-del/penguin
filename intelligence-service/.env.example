# Penguin Intelligence Service Configuration (FastAPI)
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Comma-separated list of allowed CORS origins or '*'
PENGUIN_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Rate limiting
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX_CALLS=120

# Optional OpenAI LLM integration (if omitted, service runs grounded local deterministic model)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
