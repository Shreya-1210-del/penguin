# Penguin Antarctic Digital Twin Frontend Configuration (Vite)
VITE_PORT=5173

# Node.js Express Backend Base URL
# Leave empty to use local Vite proxy in dev or relative /api in production behind reverse proxy
VITE_BACKEND_URL=

# FastAPI Resource Intelligence Service Base URL
# Leave empty to use local Vite proxy in dev or relative /api in production behind reverse proxy
VITE_INTELLIGENCE_URL=
VITE_PENGUIN_API_URL=
